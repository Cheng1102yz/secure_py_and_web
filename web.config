<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  SecureVault IIS 安全配置
  ============================================================
  此文件用于IIS服务器的安全配置
  如果使用Apache，请使用.htaccess文件
  ============================================================
-->
<configuration>
  <system.webServer>
    <!-- 禁止目录列表 -->
    <directoryBrowse enabled="false" />
    
    <!-- 默认文档 -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>
    
    <!-- 安全头 -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
    
    <!-- URL重写规则 -->
    <rewrite>
      <rules>
        <!-- 禁止直接访问敏感文件 -->
        <rule name="Block sensitive files" stopProcessing="true">
          <match url="^(backend)/(config|db|helpers)\.php$" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="禁止直接访问此文件" />
        </rule>
        
        <!-- 禁止访问初始化脚本 -->
        <rule name="Block init scripts" stopProcessing="true">
          <match url="^(backend)/init_.*\.php$" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="禁止直接访问此文件" />
        </rule>
        
        <!-- 禁止访问数据库文件 -->
        <rule name="Block database files" stopProcessing="true">
          <match url=".*\.(db|sqlite|sql)$" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="禁止访问" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  
  <!-- 禁止访问特定目录 -->
  <location path="database">
    <system.webServer>
      <handlers>
        <clear />
      </handlers>
      <staticContent>
        <mimeMap fileExtension=".*" mimeType="application/octet-stream" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Content-Disposition" value="attachment" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
